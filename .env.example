# Zoom OAuth Credentials
# Get these from https://marketplace.zoom.us/develop/create
VITE_ZOOM_CLIENT_ID=your_zoom_client_id_here
VITE_ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
VITE_ZOOM_REDIRECT_URI=http://localhost:5173/zoom-callback

# Claude API Key
# Get this from https://console.anthropic.com/
VITE_CLAUDE_API_KEY=your_claude_api_key_here
