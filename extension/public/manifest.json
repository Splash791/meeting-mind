{
  "manifest_version": 3,
  "name": "MeetingMind - Meeting Assistant",
  "version": "0.1.0",
  "description": "Real-time engagement monitoring and AI meeting summaries for Zoom",
  "permissions": [
    "storage",
    "webRequest",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetingMind"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://zoom.us/*", "https://*.zoom.us/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.js"],
      "matches": ["https://zoom.us/*", "https://*.zoom.us/*"]
    }
  ]
}
